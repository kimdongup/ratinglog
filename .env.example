# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
APP_ENV=development
# SQLite defaults to instance/ratinglog.sqlite; production needs PostgreSQL.
# DATABASE_URL=postgresql+psycopg://ratinglog:password@localhost:5432/ratinglog
RATELIMIT_STORAGE_URI=memory://
# Production: redis://localhost:6379/0
TRUSTED_HOSTS=localhost,127.0.0.1
PROXY_HOPS=0
